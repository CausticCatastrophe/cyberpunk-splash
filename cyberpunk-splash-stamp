#!/bin/bash
# Writes SystemInfo.qml for the Cyberpunk Plasma splash.
# Reads only: /etc/os-release, /etc/cyberpunk-splash.conf, /usr/lib/modules
# (directory names), the hostname, and the plasma-workspace package version.
# Every value is reduced to a safe character set before it reaches QML.
set -eu

theme=${CYBERPUNK_SPLASH_DIR:-/usr/share/plasma/look-and-feel/org.cyberpunk.splash/contents/splash}
conf=${CYBERPUNK_SPLASH_CONF:-/etc/cyberpunk-splash.conf}
osrel=${CYBERPUNK_SPLASH_OSREL:-/etc/os-release}

[ -d "$theme" ] || exit 0

clean() { printf '%s' "$1" | tr -cd 'A-Za-z0-9 ._+:/-' | cut -c1-48; }

cfg() { # cfg KEY DEFAULT
    local v
    v=$(sed -n "s/^$1=//p" "$conf" 2>/dev/null | tail -n1 || true)
    v=${v#\"}; v=${v%\"}
    printf '%s' "${v:-$2}"
}

osval() { sed -n "s/^$1=//p" "$osrel" 2>/dev/null | tail -n1 | tr -d '"' || true; }

title=$(clean "$(cfg TITLE CYBERPUNK)")
tagline=$(clean "$(cfg TAGLINE 'OS // neural desktop')")
flag() { # flag KEY DEFAULT -> true|false
    case "$(cfg "$1" "$2" | tr 'A-Z' 'a-z')" in
        yes|true|on|1) echo true ;;
        *) echo false ;;
    esac
}

hue() { # hue KEY DEFAULT_HEX -> #rrggbb (named color, hex, or the default)
    local v
    v=$(cfg "$1" "$2" | tr 'A-Z' 'a-z')
    case "$v" in
        yellow) echo '#fcee09' ;;
        cyan) echo '#02d7f2' ;;
        blue) echo '#3d8bff' ;;
        red) echo '#ff2a4b' ;;
        magenta) echo '#ff4fd8' ;;
        green) echo '#39ff88' ;;
        orange) echo '#ff7a1a' ;;
        violet) echo '#b48cff' ;;
        white) echo '#e8e6d9' ;;
        '#'[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) echo "$v" ;;
        *) echo "$2" ;;
    esac
}

username=$(clean "$(cfg USER_NAME '')")
want=$(cfg KERNEL_PKGBASE '')

kernel=$(
    for d in /usr/lib/modules/*/; do
        [ -d "$d" ] || continue
        if [ -n "$want" ] && [ "$(cat "${d}pkgbase" 2>/dev/null || true)" != "$want" ]; then
            continue
        fi
        v=${d%/}; echo "${v##*/}"
    done | sort -V | tail -n1
)
plasma=$(pacman -Q plasma-workspace 2>/dev/null | awk '{print $2}' | cut -d- -f1 || true)

osname=$(osval PRETTY_NAME)
osver=$(osval VERSION_ID)
[ -n "$osver" ] || osver=$(osval BUILD_ID)

tmp=$(mktemp "$theme/.SystemInfo.XXXXXX")
cat >"$tmp" <<EOF
import QtQuick

// Generated by cyberpunk-splash-stamp. Do not edit; see /etc/cyberpunk-splash.conf.
QtObject {
    readonly property string title: "$(clean "${title:-CYBERPUNK}")"
    readonly property string tagline: "$(clean "${tagline:-OS}")"
    readonly property string accent: "$(hue ACCENT '#fcee09')"
    readonly property string secondary: "$(hue SECONDARY '#02d7f2')"
    readonly property bool glitchTitle: $(flag GLITCH_TITLE yes)
    readonly property bool crtTear: $(flag CRT_TEAR yes)
    readonly property bool crtRoll: $(flag CRT_ROLL yes)
    readonly property bool crtFlicker: $(flag CRT_FLICKER yes)
    readonly property bool scanlines: $(flag SCANLINES yes)
    readonly property string userName: "$(clean "$username")"
    readonly property string osName: "$(clean "${osname:-Linux}")"
    readonly property string osVersion: "$(clean "${osver}")"
    readonly property string kernel: "$(clean "${kernel}")"
    readonly property string hostname: "$(clean "$(uname -n)")"
    readonly property string plasma: "$(clean "${plasma}")"
}
EOF
chmod 644 "$tmp"
mv -f "$tmp" "$theme/SystemInfo.qml"
