#!/bin/bash
# Writes SystemInfo.qml for the Cyberpunk Plasma splash.
# Reads only: /etc/os-release, /etc/cyberpunk-splash.conf, /usr/lib/modules
# (directory names), the hostname, and the plasma-workspace package version.
# Every value is reduced to a safe character set before it reaches QML.
set -eu

theme=${CYBERPUNK_SPLASH_DIR:-/usr/share/plasma/look-and-feel/org.cyberpunk.splash/contents/splash}
conf=${CYBERPUNK_SPLASH_CONF:-/etc/cyberpunk-splash.conf}
osrel=${CYBERPUNK_SPLASH_OSREL:-/etc/os-release}

[ -d "$theme" ] || exit 0

clean() { printf '%s' "$1" | tr -cd 'A-Za-z0-9 ._+:/-' | cut -c1-48; }

cfg() { # cfg KEY DEFAULT
    local v
    v=$(sed -n "s/^$1=//p" "$conf" 2>/dev/null | tail -n1 || true)
    v=${v#\"}; v=${v%\"}
    printf '%s' "${v:-$2}"
}

osval() { sed -n "s/^$1=//p" "$osrel" 2>/dev/null | tail -n1 | tr -d '"' || true; }

title=$(clean "$(cfg TITLE CYBERPUNK)")
tagline=$(clean "$(cfg TAGLINE 'OS // neural desktop')")
flag() { # flag KEY DEFAULT -> true|false
    case "$(cfg "$1" "$2" | tr 'A-Z' 'a-z')" in
        yes|true|on|1) echo true ;;
        *) echo false ;;
    esac
}

hue() { # hue KEY DEFAULT_HEX -> #rrggbb (named color, hex, or the default)
    local v
    v=$(cfg "$1" "$2" | tr 'A-Z' 'a-z')
    case "$v" in
        yellow) echo '#fcee09' ;;
        cyan) echo '#02d7f2' ;;
        blue) echo '#3d8bff' ;;
        red) echo '#ff2a4b' ;;
        magenta) echo '#ff4fd8' ;;
        green) echo '#39ff88' ;;
        orange) echo '#ff7a1a' ;;
        violet) echo '#b48cff' ;;
        pink) echo '#ff6ec7' ;;
        teal) echo '#12c29b' ;;
        lime) echo '#b6ff3d' ;;
        amber) echo '#ffb000' ;;
        ice) echo '#9fe8ff' ;;
        white) echo '#e8e6d9' ;;
        '#'[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) echo "$v" ;;
        *) echo "$2" ;;
    esac
}

username=$(clean "$(cfg USER_NAME '')")
# optional title font: an installed family name, plus a size scale in percent
titlefont=$(cfg TITLE_FONT '' | tr -cd 'A-Za-z0-9 _.-' | cut -c1-40)
taglinefont=$(cfg TAGLINE_FONT '' | tr -cd 'A-Za-z0-9 _.-' | cut -c1-40)
tscale=$(cfg TITLE_FONT_SCALE 100)
case "$tscale" in ''|*[!0-9]*) tscale=100 ;; esac
[ "$tscale" -ge 50 ] && [ "$tscale" -le 150 ] || tscale=100
titlescale=$(awk "BEGIN { printf \"%.2f\", $tscale / 100 }")
want=$(cfg KERNEL_PKGBASE '')

kernel=$(
    for d in /usr/lib/modules/*/; do
        [ -d "$d" ] || continue
        if [ -n "$want" ] && [ "$(cat "${d}pkgbase" 2>/dev/null || true)" != "$want" ]; then
            continue
        fi
        v=${d%/}; echo "${v##*/}"
    done | sort -V | tail -n1
)
plasma=$(pacman -Q plasma-workspace 2>/dev/null | awk '{print $2}' | cut -d- -f1 || true)

osname=$(osval PRETTY_NAME)
qt=$(pacman -Q qt6-base 2>/dev/null | awk '{print $2}' | cut -d- -f1 || true)
qt=${qt#*:}

tmp=$(mktemp "$theme/.SystemInfo.XXXXXX")
cat >"$tmp" <<EOF
import QtQuick

// Generated by cyberpunk-splash-stamp. Do not edit; see /etc/cyberpunk-splash.conf.
QtObject {
    readonly property string title: "$(clean "${title:-CYBERPUNK}")"
    readonly property string tagline: "$(clean "${tagline:-OS}")"
    readonly property string titleFont: "$titlefont"
    readonly property string taglineFont: "$taglinefont"
    readonly property real titleScale: $titlescale
    readonly property string accent: "$(hue ACCENT '#fcee09')"
    readonly property string secondary: "$(hue SECONDARY '#02d7f2')"
    readonly property bool glitchTitle: $(flag GLITCH_TITLE yes)
    readonly property bool crtTear: $(flag CRT_TEAR yes)
    readonly property bool crtRoll: $(flag CRT_ROLL yes)
    readonly property bool crtFlicker: $(flag CRT_FLICKER yes)
    readonly property bool scanlines: $(flag SCANLINES yes)
    readonly property string userName: "$(clean "$username")"
    readonly property string osName: "$(clean "${osname:-Linux}")"
    readonly property string qt: "$(clean "${qt}")"
    readonly property string kernel: "$(clean "${kernel}")"
    readonly property string hostname: "$(clean "$(uname -n)")"
    readonly property string plasma: "$(clean "${plasma}")"
}
EOF
chmod 644 "$tmp"
mv -f "$tmp" "$theme/SystemInfo.qml"

# Settings for the animated wallpaper plugin, when it is installed.
plugdir=${CYBERPUNK_PLUGIN_DIR:-/usr/share/plasma/wallpapers/org.cyberpunk.wallpaper}
if [ -d "$plugdir/contents/ui" ]; then
    pty=$(cfg LOGIN_TITLE_Y 40)
    case "$pty" in ''|*[!0-9]*) pty=40 ;; esac
    [ "$pty" -le 80 ] || pty=40
    # which readings the log shows, in order; only known names get through.
    # cpu, cputemp and mem are drawn in the accent color; gpu, gputemp and vram in
    # the secondary color. The older name "temp" means cputemp.
    defitems='cpu,cputemp,mem,gpu,gputemp,vram,case,uptime'
    items=""
    IFS=, read -ra arr <<<"$(cfg LOG_ITEMS "$defitems" | tr -cd 'a-z,')"
    for it in "${arr[@]}"; do
        [ "$it" = temp ] && it=cputemp
        case "$it" in
            cpu|cputemp|mem|gpu|gputemp|vram|case|uptime|os|kernel|plasma|qt|host)
                case ",$items," in *",$it,"*) ;; *) items="${items:+$items,}$it" ;; esac ;;
        esac
    done
    [ -n "$items" ] || items=$defitems
    refresh=$(cfg LOG_REFRESH 1)
    case "$refresh" in ''|*[!0-9]*) refresh=1 ;; esac
    [ "$refresh" -ge 1 ] && [ "$refresh" -le 60 ] || refresh=1
    sstep=$(cfg SPARK_STEP "$refresh")
    case "$sstep" in ''|*[!0-9]*) sstep=$refresh ;; esac
    [ "$sstep" -ge 1 ] && [ "$sstep" -le 300 ] || sstep=$refresh
    spoints=$(cfg SPARK_POINTS 60)
    case "$spoints" in ''|*[!0-9]*) spoints=60 ;; esac
    [ "$spoints" -ge 10 ] && [ "$spoints" -le 120 ] || spoints=60
    # sensor id for the case temperature line (letters, digits and / _ . - only)
    casesensor=$(cfg CASE_SENSOR '' | tr -cd 'A-Za-z0-9/_.-' | cut -c1-80)
    # graph vertical range: auto fits it to the data, fixed uses the whole range
    sscale=$(cfg SPARK_SCALE auto | tr 'A-Z' 'a-z')
    case "$sscale" in auto|fixed) ;; *) sscale=auto ;; esac
    ptmp=$(mktemp "$plugdir/contents/ui/.SystemInfo.XXXXXX" 2>/dev/null || true)
    if [ -n "$ptmp" ]; then
        cat >"$ptmp" <<PEOF
import QtQuick

// Generated by cyberpunk-splash-stamp. Do not edit; see /etc/cyberpunk-splash.conf.
QtObject {
    readonly property string title: "$(clean "${title:-CYBERPUNK}")"
    readonly property string tagline: "$(clean "${tagline:-OS}")"
    readonly property string titleFont: "$titlefont"
    readonly property string taglineFont: "$taglinefont"
    readonly property real titleScale: $titlescale
    readonly property string accent: "$(hue ACCENT '#fcee09')"
    readonly property string secondary: "$(hue SECONDARY '#02d7f2')"
    readonly property real titleY: $(awk "BEGIN { printf \"%.2f\", $pty / 100 }")
    readonly property bool showTitle: $(flag LOGIN_TITLE yes)
    readonly property bool glitchTitle: $(flag GLITCH_TITLE yes)
    readonly property bool crtTear: $(flag CRT_TEAR yes)
    readonly property bool crtRoll: $(flag CRT_ROLL yes)
    readonly property bool crtFlicker: $(flag CRT_FLICKER yes)
    readonly property bool scanlines: $(flag SCANLINES yes)
    readonly property string osName: "$(clean "${osname:-Linux}")"
    readonly property string kernel: "$(clean "${kernel}")"
    readonly property string plasma: "$(clean "${plasma}")"
    readonly property string qt: "$(clean "${qt}")"
    readonly property string hostname: "$(clean "$(uname -n)")"
    readonly property string logItems: "$items"
    readonly property int logRefresh: $refresh
    readonly property int sparkStep: $sstep
    readonly property int sparkPoints: $spoints
    readonly property string sparkScale: "$sscale"
    readonly property string caseSensor: "$casesensor"
    readonly property bool sparkSmooth: $(flag SPARK_SMOOTH yes)
}
PEOF
        chmod 644 "$ptmp"
        mv -f "$ptmp" "$plugdir/contents/ui/SystemInfo.qml"
    fi
fi

# Login-screen wallpaper: regenerate from the same settings. Best effort; a
# failure here never fails the stamp.
if [ "$(flag LOGIN_WALLPAPER yes)" = true ]; then
    wpdir=${CYBERPUNK_WALLPAPER_DIR:-/var/lib/plasmalogin/wallpapers}
    render=${CYBERPUNK_RENDER:-/usr/lib/cyberpunk-splash/render-wallpaper}
    # design for the login/lock still: Still (the original) or a plugin design
    style=$(cfg LOGIN_STYLE DataTerminal | tr -cd 'A-Za-z')
    plugdir=${CYBERPUNK_PLUGIN_DIR:-/usr/share/plasma/wallpapers/org.cyberpunk.wallpaper}
    wpqml=/usr/share/cyberpunk-splash/Wallpaper.qml
    case "$style" in
        Still|Classic|'') ;;
        *) [ -f "$plugdir/contents/ui/designs/$style.qml" ] && wpqml="$plugdir/contents/ui/designs/$style.qml" ;;
    esac
    wpqml=${CYBERPUNK_WALLPAPER_QML:-$wpqml}
    if [ -d "$wpdir" ] && [ -x "$render" ] && [ -f "$wpqml" ]; then
        wptmp=$(mktemp "$wpdir/.cyberpunk.XXXXXX.png" 2>/dev/null || true)
        if [ -n "$wptmp" ]; then
            ty=$(cfg LOGIN_TITLE_Y 40)
            case "$ty" in ''|*[!0-9]*) ty=40 ;; esac
            [ "$ty" -le 80 ] || ty=40
            if CYBERPUNK_TITLE_Y="$(awk "BEGIN { printf \"%.2f\", $ty / 100 }")" \
                CYBERPUNK_SHOW_TITLE="$(flag LOGIN_TITLE yes)" \
                CYBERPUNK_TITLE="$title" CYBERPUNK_TAGLINE="$tagline" \
                CYBERPUNK_TITLE_FONT="$titlefont" CYBERPUNK_TITLE_SCALE="$titlescale"  CYBERPUNK_TAGLINE_FONT="$taglinefont" \
                CYBERPUNK_WALLPAPER_QML="$wpqml" CYBERPUNK_FONTS_DIR="$theme/fonts" \
                timeout 60 "$render" "$wptmp" \
                "$(hue ACCENT '#fcee09')" "$(hue SECONDARY '#02d7f2')" 2>/dev/null; then
                if [ "$(id -u)" = 0 ] && id plasmalogin >/dev/null 2>&1; then
                    chown plasmalogin:plasmalogin "$wptmp"
                fi
                chmod 644 "$wptmp"
                # same image for the lock screen and desktop pickers, in a
                # place every user's session can read
                sysdir=${CYBERPUNK_SYSWALL_DIR:-/usr/share/wallpapers/CyberpunkSplash/contents/images}
                if [ -d "$sysdir" ]; then
                    install -m 644 "$wptmp" "$sysdir/2560x1440.png" || true
                fi
                mv -f "$wptmp" "$wpdir/cyberpunk-splash.png"
            else
                rm -f "$wptmp"
                echo "cyberpunk-splash-stamp: wallpaper render failed" >&2
            fi
        fi
    fi
fi
exit 0
