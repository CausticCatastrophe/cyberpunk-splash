#!/bin/bash
# Render the login wallpaper offscreen to a PNG. No display needed.
# Usage: render OUT.png [ACCENT_HEX] [SECONDARY_HEX] [WIDTH] [HEIGHT]
# Environment (all optional):
#   CYBERPUNK_TITLE, CYBERPUNK_TAGLINE   text on the wallpaper
#   CYBERPUNK_WALLPAPER_QML              path to Wallpaper.qml
#   CYBERPUNK_FONTS_DIR                  directory holding the bundled fonts
#   CYBERPUNK_TITLE_Y                    title top, 0 to 1 of the height (default 0.40)
#   CYBERPUNK_SHOW_TITLE                 true or false (default true)
#   CYBERPUNK_TITLE_FONT                 an installed font family for the title
#   CYBERPUNK_TITLE_SCALE                title size multiplier (default 1)
#   CYBERPUNK_TAGLINE_FONT               an installed font family for the tagline
set -eu

here=$(cd "$(dirname "$0")" && pwd)
qml=${CYBERPUNK_WALLPAPER_QML:-$here/Wallpaper.qml}
fonts=${CYBERPUNK_FONTS_DIR:-$here/../theme/contents/splash/fonts}
fonts=$(cd "$fonts" && pwd)
title=${CYBERPUNK_TITLE:-CYBERPUNK}
tagline=${CYBERPUNK_TAGLINE:-OS // neural desktop}
titley=${CYBERPUNK_TITLE_Y:-0.40}
showtitle=${CYBERPUNK_SHOW_TITLE:-true}
titlefont=${CYBERPUNK_TITLE_FONT:-}
titlescale=${CYBERPUNK_TITLE_SCALE:-1}
taglinefont=${CYBERPUNK_TAGLINE_FONT:-}
out=$(realpath -m "$1")
accent=${2:-#fcee09}
secondary=${3:-#02d7f2}
w=${4:-2560}
h=${5:-1440}

# register every bundled font so a font setting can name any of them
fontlines=""
for f in "$fonts"/*.ttf "$fonts"/*.otf; do
    [ -f "$f" ] && fontlines="$fontlines    FontLoader { source: \"file://$f\" }
"
done

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
chmod 700 "$work"

cat >"$work/render.qml" <<EOF
import QtQuick
import QtQuick.Window

Window {
    width: $w; height: $h; visible: true; color: "black"

$fontlines
    Loader {
        id: ld
        anchors.fill: parent
        source: "file://$qml"
        onLoaded: {
            item.accent = "$accent"
            item.secondary = "$secondary"
            item.title = "$title"
            item.tagline = "$tagline"
            item.titleY = $titley
            item.showTitle = $showtitle
            if (item.titleFont !== undefined) item.titleFont = "$titlefont"
            if (item.titleScale !== undefined) item.titleScale = $titlescale
            if (item.taglineFont !== undefined) item.taglineFont = "$taglinefont"
            if (item.showClock !== undefined) item.showClock = false   // a still image cannot tick
            if (item.liveStats !== undefined) item.liveStats = false    // readings would be frozen
        }
    }
    Timer {
        interval: 1200; running: true
        onTriggered: ld.grabToImage(function (r) {
            r.saveToFile("$out")
            Qt.quit()
        })
    }
}
EOF

XDG_RUNTIME_DIR=$work QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
    qml6 "$work/render.qml" >/dev/null 2>&1 || true
[ -s "$out" ]
