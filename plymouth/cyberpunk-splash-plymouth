#!/bin/bash
# Build the Plymouth boot theme "cyberpunk-splash" from the installed Plasma splash.
# The splash is rendered offscreen one layer at a time (see the `piece` property in
# Splash.qml), at WIDTH x HEIGHT (default 2560x1440), so it uses the fonts, colors and
# title from your /etc/cyberpunk-splash.conf as stamped by cyberpunk-splash-stamp. The
# result is a script-module theme: a static background plus a boot log, stage text and
# segmented progress bar that the script drives from Plymouth's boot progress.
#
# This only writes the theme. Apply it, and rebuild the initramfs, with:
#   sudo plymouth-set-default-theme -R cyberpunk-splash
# Go back with:
#   sudo plymouth-set-default-theme -R <previous theme>
#
# Usage: cyberpunk-splash-plymouth [WIDTH HEIGHT]
# Environment (all optional):
#   CYBERPUNK_SPLASH_DIR        directory holding Splash.qml (default: the installed theme)
#   CYBERPUNK_PLYMOUTH_DIR      where to write the theme
#   CYBERPUNK_PLYMOUTH_PREVIEW  a directory: also write a preview of every stage and all-stages.png there
set -eu

W=${1:-2560}
H=${2:-1440}
qmldir=${CYBERPUNK_SPLASH_DIR:-/usr/share/plasma/look-and-feel/org.cyberpunk.splash/contents/splash}
out=${CYBERPUNK_PLYMOUTH_DIR:-/usr/share/plymouth/themes/cyberpunk-splash}
preview=${CYBERPUNK_PLYMOUTH_PREVIEW:-}

for tool in qml6 magick awk; do
    command -v "$tool" >/dev/null || { echo "cyberpunk-splash-plymouth: $tool is required" >&2; exit 1; }
done
[ -f "$qmldir/Splash.qml" ] || { echo "cyberpunk-splash-plymouth: no Splash.qml in $qmldir" >&2; exit 1; }
grep -q 'property string piece' "$qmldir/Splash.qml" || {
    echo "cyberpunk-splash-plymouth: $qmldir/Splash.qml is too old (no piece property); reinstall the package" >&2
    exit 1
}
case "$W$H" in ''|*[!0-9]*) echo "cyberpunk-splash-plymouth: WIDTH and HEIGHT must be numbers" >&2; exit 1 ;; esac

accent=$(sed -n 's/.*property string accent: "\(#[0-9A-Fa-f]\{6\}\)".*/\1/p' "$qmldir/SystemInfo.qml" | head -n1)
accent=${accent:-#fcee09}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
chmod 700 "$work"

# ---- 1. render each layer of the splash ----
steps='{ piece: "base", stage: 0, out: "base" }'
for i in 0 1 2 3 4 5; do steps="$steps, { piece: \"log$i\", stage: 0, out: \"log$i\" }"; done
for i in 0 1 2 3 4 5 6; do steps="$steps, { piece: \"stage\", stage: $i, out: \"stage$i\" }"; done

cat >"$work/render.qml" <<QML
import QtQuick
import QtQuick.Window

Window {
    width: $W; height: $H; visible: true; color: "transparent"
    property int idx: 0
    readonly property var steps: [ $steps ]

    Loader {
        id: ld
        anchors.fill: parent
        source: "file://$qmldir/Splash.qml"
        onLoaded: next()
        onStatusChanged: if (status === Loader.Error) Qt.exit(1)
    }
    function next() {
        if (idx >= steps.length) { Qt.quit(); return }
        ld.item.piece = steps[idx].piece
        ld.item.stage = steps[idx].stage
        settle.restart()
    }
    Timer {
        id: settle
        interval: 500
        onTriggered: ld.grabToImage(function (r) {
            r.saveToFile("$work/" + steps[idx].out + ".png")
            idx++
            next()
        })
    }
}
QML

[ -z "${CYBERPUNK_PLYMOUTH_KEEP:-}" ] || cp "$work/render.qml" "$CYBERPUNK_PLYMOUTH_KEEP"
XDG_RUNTIME_DIR=$work QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
    timeout 90 qml6 "$work/render.qml" >"${CYBERPUNK_PLYMOUTH_LOG:-/dev/null}" 2>&1 || true
for n in base log0 log1 log2 log3 log4 log5 stage0 stage1 stage2 stage3 stage4 stage5 stage6; do
    [ -s "$work/$n.png" ] || { echo "cyberpunk-splash-plymouth: rendering $n failed" >&2; exit 1; }
done

# ---- 2. crop the pieces and compute where each goes ----
mkdir -p "$out"
tmpout=$(mktemp -d "$out.XXXXXX")
trap 'rm -rf "$work" "$tmpout"' EXIT
cp "$work/base.png" "$tmpout/base.png"

# crop NAME -> sets cx, cy to the piece's offset in the full image
crop() {
    local geo
    geo=$(magick "$work/$1.png" -format '%@' info:)
    magick "$work/$1.png" -crop "$geo" +repage "$tmpout/$1.png"
    cx=${geo#*+}; cx=${cx%%+*}
    cy=${geo##*+}
}

# geometry of the solid pieces, from the same formulas as Splash.qml (u = 1% of the width)
read -r segw segh segx segy pitch curw curh curx cury0 lineh < <(awk -v W="$W" -v H="$H" 'BEGIN {
    u = W / 100
    segw = (46 * u - 6 - 47 * 2) / 48
    printf "%d %d %d %d %.3f %d %d %d %d %.3f\n",
        segw + 0.5, 1.1 * u - 6 + 0.5, W / 2 - 23 * u + 3 + 0.5, H - 7.6 * u + 3 + 0.5, segw + 2,
        0.7 * u + 0.5, 1.3 * u + 0.5, W / 2 - 23 * u + 1.6 * u + 0.5,
        H * 0.5 + (u * 1.25 * 1.75 - 1.3 * u) / 2 + 0.5, u * 1.25 * 1.75
}')

magick -size "${segw}x${segh}" "xc:$accent" "$tmpout/seg.png"
magick -size "${curw}x${curh}" "xc:$accent" "$tmpout/cursor.png"
magick -size "${W}x3" xc:none -fill 'rgba(0,0,0,0.28)' -draw "rectangle 0,0 $((W - 1)),0" "$work/scanpat.png"
magick -size "${W}x${H}" "tile:$work/scanpat.png" "$tmpout/scan.png"

assign=""
for i in 0 1 2 3 4 5; do
    crop "log$i"; lx[i]=$cx; ly[i]=$cy; assign="$assign
LOG_X[$i] = $cx;
LOG_Y[$i] = $cy;
LOG_IMAGE[$i] = Image (\"log$i.png\");"
done
for i in 0 1 2 3 4 5 6; do
    crop "stage$i"; sx[i]=$cx; sy[i]=$cy; assign="$assign
STAGE_X[$i] = $cx;
STAGE_Y[$i] = $cy;
STAGE_IMAGE[$i] = Image (\"stage$i.png\");"
done

# ---- 3. the Plymouth script ----
cat >"$tmpout/cyberpunk-splash.script" <<SCRIPT
# Cyberpunk Splash boot theme, generated by cyberpunk-splash-plymouth. Do not edit by hand.
#
# Layers: base.png (grid, frame, title, corner text), one image per boot log line and per
# stage text, a segmented progress bar made of seg.png, a blinking cursor and a scanline
# overlay. Everything is placed in a ${W}x${H} reference and scaled to each screen.

REF_W = $W;
REF_H = $H;
SEG_COUNT = 48;
SEG_X = $segx;
SEG_Y = $segy;
SEG_PITCH = $pitch;
CUR_X = $curx;
CUR_Y0 = $cury0;
LINE_H = $lineh;
$assign

Window.SetBackgroundTopColor (0.0196, 0.0196, 0.0235);
Window.SetBackgroundBottomColor (0.0196, 0.0196, 0.0235);

BASE_IMAGE = Image ("base.png");
SCAN_IMAGE = Image ("scan.png");
SEG_IMAGE = Image ("seg.png");
CURSOR_IMAGE = Image ("cursor.png");

progress = 0;
frame = 0;

fun scaled (image, s)
  {
    if (s == 1)
      return image;
    return image.Scale (Math.Int (image.GetWidth () * s + 0.5), Math.Int (image.GetHeight () * s + 0.5));
  }

# one set of sprites per screen, centered and scaled to fit
fun build_head (index)
  {
    local.h;
    local.w = Window.GetWidth (index);
    local.ht = Window.GetHeight (index);
    local.s = w / REF_W;
    if (ht / REF_H < s)
      s = ht / REF_H;
    h.s = s;
    h.x = Window.GetX (index) + (w - REF_W * s) / 2;
    h.y = Window.GetY (index) + (ht - REF_H * s) / 2;

    h.base = Sprite (scaled (BASE_IMAGE, s));
    h.base.SetPosition (h.x, h.y, 10);
    h.scan = Sprite (scaled (SCAN_IMAGE, s));
    h.scan.SetPosition (h.x, h.y, 100);

    for (bk = 0; bk < 6; bk++)
      {
        h.log[bk] = Sprite (scaled (LOG_IMAGE[bk], s));
        h.log[bk].SetPosition (h.x + LOG_X[bk] * s, h.y + LOG_Y[bk] * s, 20);
        h.log[bk].SetOpacity (0);
      }
    for (bk = 0; bk < 7; bk++)
      {
        h.stage[bk] = Sprite (scaled (STAGE_IMAGE[bk], s));
        h.stage[bk].SetPosition (h.x + STAGE_X[bk] * s, h.y + STAGE_Y[bk] * s, 20);
        h.stage[bk].SetOpacity (0);
      }
    local.seg = scaled (SEG_IMAGE, s);
    for (bk = 0; bk < SEG_COUNT; bk++)
      {
        h.seg[bk] = Sprite (seg);
        h.seg[bk].SetPosition (h.x + (SEG_X + bk * SEG_PITCH) * s, h.y + SEG_Y * s, 20);
        h.seg[bk].SetOpacity (0.1);
      }
    h.cursor = Sprite (scaled (CURSOR_IMAGE, s));
    h.cursor.SetPosition (h.x + CUR_X * s, h.y + CUR_Y0 * s, 25);
    return h;
  }

heads[0] = build_head (0);
for (hi = 1; hi < 8 && Window.GetWidth (hi); hi++)
  {
    heads[hi] = build_head (hi);
  }

fun update_progress ()
  {
    local.st = Math.Int (progress * 6.999);
    if (st > 6)
      st = 6;
    if (st < 0)
      st = 0;
    local.lit = progress * SEG_COUNT;
    for (ui = 0; heads[ui]; ui++)
      {
        local.h = heads[ui];
        for (uk = 0; uk < 6; uk++)
          {
            if (uk < st)
              h.log[uk].SetOpacity (1);
            else
              h.log[uk].SetOpacity (0);
          }
        for (uk = 0; uk < 7; uk++)
          {
            if (uk == st)
              h.stage[uk].SetOpacity (1);
            else
              h.stage[uk].SetOpacity (0);
          }
        for (uk = 0; uk < SEG_COUNT; uk++)
          {
            if (uk < lit)
              h.seg[uk].SetOpacity (1);
            else
              h.seg[uk].SetOpacity (0.1);
          }
        h.cursor.SetY (h.y + (CUR_Y0 + st * LINE_H) * h.s);
      }
  }

# the cursor blinks every half second; this runs about 50 times a second
fun refresh_callback ()
  {
    frame++;
    local.blink = Math.Int (frame / 25) % 2;
    for (ri = 0; heads[ri]; ri++)
      {
        if (blink == 0)
          heads[ri].cursor.SetOpacity (1);
        else
          heads[ri].cursor.SetOpacity (0);
      }
  }

fun boot_progress (time, value)
  {
    if (Plymouth.GetMode () == "boot")
      {
        global.progress = value;
        update_progress ();
      }
  }

# shutdown, reboot and update screens show a finished bar
if (Plymouth.GetMode () != "boot")
  progress = 1;
update_progress ();

Plymouth.SetRefreshFunction (refresh_callback);
Plymouth.SetBootProgressFunction (boot_progress);
SCRIPT

cat >"$tmpout/cyberpunk-splash.plymouth" <<PLY
[Plymouth Theme]
Name=Cyberpunk Splash
Description=Boot splash matching the Cyberpunk Splash theme
ModuleName=script

[script]
ImageDir=$out
ScriptFile=$out/cyberpunk-splash.script
PLY

chmod -R u=rwX,go=rX "$tmpout"

# ---- 4. install, replacing any previous build ----
rm -rf "$out.old"
[ -d "$out" ] && mv "$out" "$out.old"
mv "$tmpout" "$out"
rm -rf "$out.old"

# ---- optional preview: every stage as it would look on screen, and a contact sheet ----
# Stage N has N log lines, the stage text, the bar N/6 full and the cursor on row N.
if [ -n "$preview" ]; then
    mkdir -p "$preview"
    magick "$out/seg.png" -alpha set -channel A -evaluate multiply 0.1 +channel "$work/segdim.png"
    for st in 0 1 2 3 4 5 6; do
        lit=$(( (st * 48 + 3) / 6 ))
        cmd=(magick -size "${W}x${H}" xc:'#050506' "$out/base.png" -composite)
        for ((i = 0; i < st; i++)); do
            cmd+=("$out/log$i.png" -geometry "+${lx[$i]}+${ly[$i]}" -composite)
        done
        cmd+=("$out/stage$st.png" -geometry "+${sx[$st]}+${sy[$st]}" -composite)
        for j in $(seq 0 47); do
            px=$(awk -v a="$segx" -v p="$pitch" -v j="$j" 'BEGIN { printf "%d", a + j * p + 0.5 }')
            if [ "$j" -lt "$lit" ]; then
                cmd+=("$out/seg.png" -geometry "+$px+$segy" -composite)
            else
                cmd+=("$work/segdim.png" -geometry "+$px+$segy" -composite)
            fi
        done
        cy=$(awk -v y="$cury0" -v l="$lineh" -v s="$st" 'BEGIN { printf "%d", y + s * l + 0.5 }')
        cmd+=("$out/cursor.png" -geometry "+$curx+$cy" -composite "$out/scan.png" -composite "$preview/stage$st.png")
        "${cmd[@]}" || echo "cyberpunk-splash-plymouth: preview of stage $st failed" >&2
    done
    magick montage "$preview"/stage[0-6].png -tile 2x -geometry 1280x720+6+6 -background '#15151a' \
        "$preview/all-stages.png" 2>/dev/null || echo "cyberpunk-splash-plymouth: contact sheet failed" >&2
fi

echo "cyberpunk-splash-plymouth: theme written to $out"
echo "To use it: sudo plymouth-set-default-theme -R cyberpunk-splash"
